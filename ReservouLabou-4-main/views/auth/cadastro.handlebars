
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro</title>
    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>
    <div class="container-login">
        <div class="login-box">

            <h2>Cadastro</h2>

            <form action="/auth/cadastro" method="POST">

                <label>Usuário</label>
                <input type="text" name="Login" required>

                <label>Senha</label>
                <input type="password" name="Senha" required>

                <label>Chave de administrador (opcional)</label>
                <input
                    type="password"
                    name="ChaveADM"
                    placeholder="Digite somente se for administrador"
                >

                <button type="submit">
                    Cadastrar
                </button>

            </form>

        </div>
    </div>
</body>

</html>
