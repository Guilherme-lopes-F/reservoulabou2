<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciar Laboratórios</title>
    <link rel="stylesheet" href="/css/laboratoriolistar.css">
</head>

<body>
    <div class="laboratorios-page">

        <div class="top-bar">
            <h1>Gerenciar Laboratórios</h1>

            <a href="/admin" class="btn-novo">
                Voltar ao Painel
            </a>

            <a href="/admin/laboratorios/novo" class="btn-novo">
                + Novo Laboratório
            </a>
        </div>

        <div class="tabela-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Entrada</th>
                        <th>Saída</th>
                        <th>Dias disponíveis</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each laboratorios}}
                    <tr>
                        <td>{{IdLab}}</td>

                        <td class="nome-lab">
                            {{NomeLab}}
                        </td>

                        <td>{{HoraEntrada}}</td>

                        <td>{{HoraSaida}}</td>

                        <td>
                            {{#if DiasDispos}}
                            <div class="dias">
                                {{#each DiasDispos}}
                                <span class="dia">
                                    {{NomeDia}}
                                </span>
                                {{/each}}
                            </div>
                            {{else}}
                            <span class="sem-dias">
                                Nenhum dia cadastrado
                            </span>
                            {{/if}}
                        </td>

                        <td class="acoes">
                            <a href="/admin/laboratorios/editar/{{IdLab}}" class="btn-editar">
                                Editar
                            </a>

                            <a href="/admin/laboratorios/excluir/{{IdLab}}" class="btn-excluir"
                                onclick="return confirm('Tem certeza de que deseja excluir este laboratório?')">
                                Excluir
                            </a>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="6" class="sem-registros">
                            Nenhum laboratório cadastrado.
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

    </div>
</body>

</html>
